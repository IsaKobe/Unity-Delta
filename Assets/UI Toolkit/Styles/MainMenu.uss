.map-button {
    flex-grow: 1;
    width: 50px;
    height: 50px;
    aspect-ratio: 1;
    max-height: 50px;
    max-width: 50px;
    position: absolute;
    transition-duration: 0.2s;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgb(115, 115, 115);
    border-right-color: rgb(115, 115, 115);
    border-top-color: rgb(115, 115, 115);
    border-bottom-color: rgb(115, 115, 115);
    background-color: rgb(0, 0, 157);
}

.map-button:hover {
    -unity-material: url("project://database/Assets/Shader/Test.shadergraph?fileID=-876546973899608171&guid=52c2f8c718955b5449a8f64ac127b9b8&type=3#Test");
    scale: 1.1 1.1;
    transition-duration: 0.2s;
}

.map-button > Label {
    width: 100%;
    height: 100%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-center;
}

LevelInfo {
    background-color: rgba(255, 255, 255, 0.2);
    justify-content: space-between;
}

#header-row {
    background-color: rgba(0, 0, 0, 0.6);
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    justify-content: space-between;
    flex-direction: row;
}

#header-row > Label {
    font-size: 30px;
    -unity-text-align: middle-center;
    flex-grow: 1;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

#header-row > Button {
    aspect-ratio: 1;
    align-self: center;
    align-items: center;
    margin-top: 0;
    margin-right: 5px;
    margin-bottom: 0;
    margin-left: 0;
}

#score {
    align-self: center;
}

.back {
    position: absolute;
    left: 10px;
    top: 10px;
}

.selected {
    -unity-material: url("project://database/Assets/Shader/Test.mat?fileID=2100000&guid=925be8477f1b75d4db8da4ef266796cc&type=2#Test") prop("_Speed" 0.2) prop("_Color" rgb(19, 106, 255));
    transition-duration: 0.2s;
}
