.menu {
    flex-grow: 1;
    padding-top: 5%;
    padding-left: 5%;
    padding-right: 5%;
    padding-bottom: 5%;
    max-width: 50%;
}

#Change-Value {
    margin-top: 20px;
    flex-direction: row;
    justify-content: center;
}

#Change-Add {
    margin-top: 20px;
    flex-direction: row;
    justify-content: center;
    -unity-text-align: middle-center;
}

.item-element {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.item-element > Label {
    -unity-text-align: middle-right;
    flex-grow: 1;
}

#Item-Header {
    -unity-text-align: upper-center;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

#Info {
    flex-grow: 1;
    padding-top: 20px;
}

#Item-Image {
    flex-grow: 1;
    aspect-ratio: 1;
    max-height: 55%;
    align-self: center;
}

#Change {
    margin-top: 20px;
}

#Change-Title {
    -unity-text-align: upper-center;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

#Cost {
    flex-grow: 1;
    flex-direction: row;
    max-height: 8%;
    justify-content: space-between;
}

#Paragraph {
    font-size: 25px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 20px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    min-height: 20%;
    white-space: normal;
}

#Cost-Row {
    flex-grow: 1;
    flex-direction: row;
}

#Arrow {
    background-image: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=-1087164816274819069&guid=38ecaae058d867c46ad5e207016765d2&type=3#arrow-right@2x");
    aspect-ratio: 1;
    width: 50px;
    height: 50px;
}

#Change-Value > Label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-center;
    align-self: center;
    position: absolute;
    align-content: auto;
}
