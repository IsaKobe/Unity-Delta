VisualElement > #Health > #unity-progress-bar > .unity-progress-bar__background > .unity-progress-bar__progress {
    background-color: rgb(255, 0, 0);
}

VisualElement > #Health > #unity-progress-bar > .unity-progress-bar__background {
    background-color: rgb(138, 255, 0);
}



.test {
    background-color: rgb(255, 0, 0);
    transition-duration: 0.2s;
}

.test:hover {
    background-color: rgb(69, 0, 255);
    scale: 1.05 1.05;
    transition-duration: 0.2s;
}
