<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles/Buttons.uss?fileID=7433441132597879392&amp;guid=350c5848bb4d63a44bca9b7468436928&amp;type=3"/>
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(0, 0, 0); color: rgb(255, 255, 255);">
        <ui:VisualElement name="Overview" style="height: 87%;">
            <ui:Label text="Victory" name="Title" style="-unity-text-align: middle-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2%; padding-right: 0; padding-bottom: 1%; padding-left: 0; font-size: 75px;"/>
            <ui:VisualElement name="Score" style="flex-grow: 1; align-self: center; min-width: 35%;">
                <ui:VisualElement name="Line" class="line" style="display: none;">
                    <ui:Label text="Enemies killed" style="font-size: 40px; -unity-text-align: middle-center;"/>
                    <ui:Label text="88888888" style="-unity-font-style: normal; font-size: 35px; -unity-text-align: middle-right;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Line" class="line" style="display: none;">
                    <ui:Label text="Enemies killed" style="font-size: 40px; -unity-text-align: middle-center;"/>
                    <ui:Label text="88888888" style="-unity-font-style: normal; font-size: 35px; -unity-text-align: middle-right;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Total" style="flex-grow: 1; justify-content: flex-end;">
                    <ui:VisualElement name="Line" class="line">
                        <ui:Label text="Total score" style="font-size: 40px; -unity-text-align: middle-center;"/>
                        <ui:Label text="88888888" name="TotalScore" style="-unity-font-style: normal; font-size: 35px; -unity-text-align: middle-right;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Buttons" style="flex-grow: 1; flex-direction: row; height: 50px; justify-content: space-around; align-self: center; min-width: 35%; padding-bottom: 2%; padding-top: 2%;">
            <ui:Button text="Retry" name="Retry" class="test"/>
            <ui:Button text="Continue" name="Continue" class="test"/>
            <ui:Button text="Exit" name="Exit" class="test"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
